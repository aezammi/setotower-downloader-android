<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="appearance"
        app:icon="@drawable/ic_settings"
        android:title="@string/general"/>

    <Preference
        android:key="folders"
        app:icon="@drawable/baseline_folder_24"
        android:title="@string/directories"/>

    <Preference
        android:key="downloading"
        app:icon="@drawable/ic_downloads"
        android:title="@string/downloads"/>

    <Preference
        android:key="processing"
        app:icon="@drawable/baseline_star_half_24"
        android:title="@string/processing"/>

    <Preference
        android:key="advanced"
        app:icon="@drawable/baseline_settings_suggest_24"
        android:title="@string/advanced"/>

    <PreferenceCategory android:title="@string/about" >
        <Preference
            app:icon="@drawable/baseline_security_24"
            app:key="security"
            app:summary="@string/privacy_policy"
            app:title="@string/privacy_policy">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/aezammi/setotower-downloader-android/blob/main/SECURITY.md" />
        </Preference>

        <Preference
            app:icon="@drawable/ic_link"
            app:key="visit_website"
            app:title="@string/visit_website">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://downloader.setotower.com" />
        </Preference>

        <Preference
            app:icon="@drawable/ic_discord"
            app:key="join_discord"
            app:title="@string/join_discord">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://discord.gg/qgh7CNe7Su" />
        </Preference>

        <Preference
            app:icon="@drawable/ic_license"
            app:key="license"
            app:summary="GNU General Public License v3.0"
            app:title="@string/license">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/aezammi/setotower-downloader-android/blob/main/LICENSE" />
        </Preference>

        <Preference
            app:icon="@drawable/ic_code"
            app:key="rreth"
            app:summary="https://github.com/aezammi/setotower-downloader-android"
            app:allowDividerBelow="true"
            app:title="@string/source_code">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/aezammi/setotower-downloader-android" />
        </Preference>

        <Preference
            app:icon="@drawable/ic_power"
            app:key="terminate_app"
            app:summary="Stop downloads and close Setotower Downloader"
            app:title="@string/kill_app" />


    </PreferenceCategory>


</PreferenceScreen>
