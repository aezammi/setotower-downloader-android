<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_search_red"
        android:shortcutShortLabel="@string/search"
        android:shortcutDisabledMessage="@string/search">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.setotower.downloader"
            android:targetClass="com.setotower.downloader.MainActivity">

            <extra android:name="destination" android:value="Search" />

        </intent>
    </shortcut>


    <shortcut
        android:shortcutId="downloads"
        android:enabled="true"
        android:icon="@drawable/ic_downloads_red"
        android:shortcutShortLabel="@string/downloads"
        android:shortcutDisabledMessage="@string/downloads">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.setotower.downloader"
            android:targetClass="com.setotower.downloader.MainActivity">

            <extra android:name="destination" android:value="Downloads" />

        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="movies"
        android:enabled="true"
        android:icon="@drawable/baseline_downloading_red"
        android:shortcutShortLabel="@string/movies"
        android:shortcutDisabledMessage="@string/movies">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.setotower.downloader"
            android:targetClass="com.setotower.downloader.MainActivity">

            <extra android:name="destination" android:value="Movies" />

        </intent>
    </shortcut>

</shortcuts>
